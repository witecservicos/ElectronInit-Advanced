# =====================================================================
#  WIWITRACK ESCOLA  -  EXEMPLE DE CONFIGURATION
#  Copiez ce fichier en `.env` et renseignez vos valeurs.
# =====================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Base LOCALE (poste serveur de l'ecole) ---
DB_NAME=wiwitrack_escola
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql
DB_LOGGING=false
# En DEV uniquement : laisser Sequelize creer/alterer les tables
DB_AUTO_SYNC=false
DB_AUTO_ALTER=false

# --- Authentification ---
JWT_SECRET=Wesmarland65225034@
JWT_EXPIRES=12h
BCRYPT_ROUNDS=10

# --- Decouverte reseau (nom de domaine mDNS au lieu d'une IP) ---
DISCOVERY_ENABLED=true
DISCOVERY_NAME=wiwitrack-escola
DISCOVERY_TYPE=http
# Les clients joignent alors : http://wiwitrack-escola.local:4000

# --- CORS (vide = autoriser le LAN) ---
CORS_ORIGINS=

# --- Base DISTANTE / CLOUD (synchro) : TEMPLATE, desactive par defaut ---
# Passez a true ET renseignez vos vrais acces pour activer la synchro.
REMOTE_SYNC_ENABLED=false
REMOTE_DB_NAME=
REMOTE_DB_USER=
REMOTE_DB_PASS=
REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_DIALECT=mysql
REMOTE_SYNC_CRON=*/10 * * * *
