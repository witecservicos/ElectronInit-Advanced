{
  "name": "wiwitrack-escola",
  "version": "1.0.1",
  "description": "WIWITRACK ESCOLA & CRECHE - ERP scolaire angolais (Local-First, Electron + Express 5 + Sequelize/MySQL)",
  "main": "./electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "server": "node ./server",
    "dev": "nodemon ./server",
    "seed": "node ./server/database/seed.js",
    "build": "electron-builder",
    "release": "dotenv -e .env -- electron-builder --publish always"
  },
  "keywords": [
    "wiwitrack",
    "escola",
    "erp",
    "angola",
    "local-first",
    "electron",
    "sequelize"
  ],
  "author": "Charles André Wesmarland <witecservicos@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "bonjour-service": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "ip": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "node-cron": "^4.0.0",
    "sequelize": "^6.37.8",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/ip": "^1.1.3",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.14",
    "wait": "^0.4.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publish": {
    "provider": "github",
    "owner": "witecservicos",
    "repo": "ElectronInit-Advanced",
    "draft": false,
    "prerelease": false
  },
  "build": {
    "appId": "com.witec.wiwitrack",
    "productName": "Wiwitrack Escola",
    "icon": "build/wiEscola-logo.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "electron/**/*",
      "server/**/*",
      "build/**/*"
    ],
    "win": {
      "icon": "build/wiEscola-logo.ico",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}